{
  "manifest_version":3,"name":"ins-cli","version":"0.5.0",
  "description":"Connect the Instagram tab you select to a local terminal. No cookies or passwords are read.",
  "permissions":["storage","activeTab","alarms"],
  "host_permissions":["http://127.0.0.1/*"],
  "background":{"service_worker":"background.js"},
  "action":{"default_popup":"popup.html"},
  "content_scripts":[{"matches":["https://www.instagram.com/*"],"js":["unread.js","message-format.js","live-reader.js","content.js"],"run_at":"document_idle"}]
}
